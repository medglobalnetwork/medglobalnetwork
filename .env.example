# ============================================================
# MGN.life Production Environment Variables Template
# ============================================================

# 1. Base App & Better-Auth URLs (Production domain)
BETTER_AUTH_URL=https://www.mgn.life
NEXT_PUBLIC_APP_URL=https://www.mgn.life

# 2. Better-Auth Encryption Secret (Generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your_32_character_better_auth_secret_key

# 3. Better-Auth Cloud Dashboard API Key (From dash.better-auth.com)
BETTER_AUTH_API_KEY=your_better_auth_api_key_here

# 4. PostgreSQL / Supabase Database Connection URL (Use Transaction/Session Pooler)
SUPABASE_DATABASE_URL=postgresql://postgres.xxxx:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 5. Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 6. Admin Panel Access (Comma-separated admin email addresses for /admin access)
ADMIN_EMAILS=admin@mgn.life,founder@mgn.life
